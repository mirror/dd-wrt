+				"IRQ %d: CPU %d saturated (ENOSPC), slots_left set to %d\n",
+				info->irq, info->assigned_obj->number, SLOTS_SATURATED);
+		} else {
+			log(TO_ALL, LOG_DEBUG,
+				"IRQ %d: ENOSPC on domain-assigned IRQ (obj_type=%d)\n",
