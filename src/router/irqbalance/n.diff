+ *          → Prefers the higher-load CPU with more headroom
+ *
+ * CPUs with slots_left >= SLOTS_PENALTY_THRESHOLD get zero penalty,
+ * so their placement is determined purely by load balancing.
+ */
+#define SLOTS_PENALTY_FACTOR 1000
