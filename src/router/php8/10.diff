diff -urpN php-8.5.9/ext/reflection/tests/ReflectionClassConstant_double_construct.phpt php-8.5.10/ext/reflection/tests/ReflectionClassConstant_double_construct.phpt
--- php-8.5.9/ext/reflection/tests/ReflectionClassConstant_double_construct.phpt	1970-01-01 06:00:00.000000000 +0600
+++ php-8.5.10/ext/reflection/tests/ReflectionClassConstant_double_construct.phpt	2026-08-26 03:09:32.000000000 +0600
@@ -0,0 +1,33 @@
+--TEST--
+ReflectionClassConstant double construct call does not leak $name and $class
+--FILE--
+<?php
+
+class C {
+    const FOO = 1;
+}
+
+function test(ReflectionClassConstant $r) {
+    /* implode() so that the name is not an interned string. */
+    $r->__construct(C::class, implode('', ['F', 'O', 'O']));
+}
+
+$r = new ReflectionClassConstant(C::class, 'FOO');
+for ($i = 0; $i < 10; $i++) {
+    test($r);
+}
+
+$before = memory_get_usage();
+for ($i = 0; $i < 1000; $i++) {
+    test($r);
+}
+$after = memory_get_usage();
+
+var_dump($before === $after);
+var_dump($r->name, $r->class);
+
+?>
+--EXPECT--
+bool(true)
+string(3) "FOO"
+string(1) "C"
diff -urpN php-8.5.9/ext/reflection/tests/ReflectionClass_getProperty_anonymous_class.phpt php-8.5.10/ext/reflection/tests/ReflectionClass_getProperty_anonymous_class.phpt
