+
+?>
+--EXPECT--
+Error: Cannot instantiate abstract class R
+string(1) "a"
diff -urpN php-8.5.9/ext/reflection/tests/ReflectionMethod_createFromMethodName_anonymous_class.phpt php-8.5.10/ext/reflection/tests/ReflectionMethod_createFromMethodName_anonymous_class.phpt
