<fieldset>
	<legend><script type="text/javascript">Capture(service.alarmserver)</script></legend>
		<div class="setting">
			<div class="label"><% tran("freeradius.srv"); %></div>
			<input class="spaceradio" type="radio" name="alarmserver" value="1" <% nvc("alarmserver", "1"); %> onclick="show_layer_ext(this, 'idalarmserver', true)" /><% tran("share.enable"); %>&nbsp;
			<input class="spaceradio" type="radio" name="alarmserver" value="0" <% nvc("alarmserver", "0"); %> onclick="show_layer_ext(this, 'idalarmserver', false)" /><% tran("share.disable"); %>
		</div>
		<div id="idalarmserver">
			<div class="setting">
				<div class="label"><% tran("service.alarmserver_cmd"); %></div>
					<textarea cols="60" rows="4" id="alarmserver_cmd" name="alarmserver_cmd"></textarea>
					<script type="text/javascript">
					//<![CDATA[
						var alarmserver_cmd = fix_cr( '<% nvg("alarmserver_cmd"); %>' );
						document.getElementById("alarmserver_cmd").value = alarmserver_cmd;
					//]]>
					</script>
			</div>
		</div>
</fieldset><br />
